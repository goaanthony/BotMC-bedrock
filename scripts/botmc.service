[Unit]
Description=BotMC - passerelle Minecraft Bedrock (Xbox Live)
Documentation=file://@INSTALL_DIR@/README.md
After=network-online.target
Wants=network-online.target
# Abandonne après 10 crashs en 5 minutes (évite de spammer Xbox Live)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@BOT_USER@
Group=@BOT_USER@
WorkingDirectory=@INSTALL_DIR@
Environment=NODE_ENV=production
Environment=HOME=@INSTALL_DIR@
ExecStart=@NODE_BIN@ @INSTALL_DIR@/src/cli.js start
Restart=always
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGTERM

# Durcissement : le bot n'a besoin d'écrire que dans son dossier
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=@PROTECT_HOME@
ReadWritePaths=@INSTALL_DIR@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
