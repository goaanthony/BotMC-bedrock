# ═══════════════════════════════════════════════════════════
#  MINECRAFT BEDROCK GATEWAY BOT — Configuration
# ═══════════════════════════════════════════════════════════
#  Copie ce fichier en .env et remplis les valeurs.
# ═══════════════════════════════════════════════════════════

# ── Serveur cible (ton vrai serveur Minecraft Bedrock) ──────
TARGET_HOST=mon-serveur.exemple.com
TARGET_PORT=19132

# ── Serveur passerelle (CETTE machine) ──────────────────────
# Port UDP à ouvrir sur le routeur/firewall
GATEWAY_PORT=19132

# IP PUBLIQUE de cette machine (indispensable pour MPSD / Xbox Live)
# Pour la trouver : https://api.ipify.org
GATEWAY_PUBLIC_IP=1.2.3.4

# ── Affichage ────────────────────────────────────────────────
# Nom du monde affiché dans la liste d'amis Xbox Live
WORLD_NAME=Mon Serveur Minecraft

# MOTD affiché dans la liste des serveurs Bedrock
GATEWAY_MOTD=Rejoins le serveur !

# Nombre maximum de joueurs (affiché dans la session)
MAX_PLAYERS=20

# ── Gestionnaire d'amis ──────────────────────────────────────
# Intervalle en ms pour accepter automatiquement les demandes d'amis
FRIEND_POLL_INTERVAL_MS=30000

# ── Authentification Xbox Live ───────────────────────────────
# Répertoire de cache pour les tokens (créé automatiquement)
AUTH_CACHE_DIR=./auth_cache

# Label du compte hôte dans le cache (utile si tu as plusieurs comptes)
HOST_ACCOUNT_LABEL=gateway-host
