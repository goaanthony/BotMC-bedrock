# ═══════════════════════════════════════════════════════════
#  BotMC — Configuration
#  Copie ce fichier en .env et remplis au moins TARGET_HOST.
#  Sur un serveur installé avec install.sh : « botmc config »
# ═══════════════════════════════════════════════════════════

# ── Mode ────────────────────────────────────────────────────
# gateway : passerelle (onglet Amis → transfert)    [défaut]
# friends : acceptation des amis seulement (BDS)
BOT_MODE=gateway

# ── Serveur cible (obligatoire en mode gateway) ─────────────
TARGET_HOST=mon-serveur.exemple.com
TARGET_PORT=19132

# ── Session affichée dans l'onglet Amis ─────────────────────
WORLD_NAME=Mon Serveur Minecraft
GATEWAY_MOTD=Rejoins le serveur !
# Texte libre affiché comme « version » sur la carte du monde
WORLD_VERSION=Passerelle
MAX_PLAYERS=20
# friends_of_friends | friends_only | invite_only
JOINABILITY=friends_of_friends
# Délai avant de republier la session après un transfert (ms)
SESSION_REFRESH_DELAY_MS=3000

# ── Amis ────────────────────────────────────────────────────
# Ajoute en ami les comptes qui suivent le bot.
# Attention : retire aussi les amis qui ne suivent plus le bot.
AUTO_FRIEND_ADD=true
# Mode friends : vérification de secours en ms (min 5000)
FRIEND_POLL_INTERVAL_MS=30000

# ── Logs ────────────────────────────────────────────────────
# debug | info | warn | error   (debug affiche aussi les logs Xbox/NetherNet)
LOG_LEVEL=info
# auto (couleurs dans un terminal, texte sinon) | pretty | plain | json
LOG_FORMAT=auto
LOG_TO_FILE=true
LOG_DIR=./logs
LOG_RETENTION_DAYS=14
# Résumé des statistiques dans les logs toutes les N minutes (0 = jamais)
STATS_INTERVAL_MIN=60

# ── Compte Xbox du bot ──────────────────────────────────────
# Utilise un compte secondaire, jamais ton compte principal.
HOST_ACCOUNT_LABEL=gateway-host
AUTH_CACHE_DIR=./auth_cache
DATA_DIR=./data
